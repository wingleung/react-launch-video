---
/*
 * The page is one story told in five bands, each with one real picture, in the order a launch video gets made:
 *
 * 1. What it is, and for which stack: the video the plugin made, with its timeline.
 * 2. It plans first: that same video's holds against their reading time.
 * 3. It renders what you ship: React first, then the CLI video as the secondary case.
 * 4. It checks its work: real gate output on the video from band 1, then the review skill.
 * 5. The ask: try it on the test app, then on your product.
 *
 * Every number on it is measured from the reels in docs/ or read from the repo, never typed from memory.
 */
import "../styles/global.css";
import { getImage } from "astro:assets";
import Command from "../components/Command.astro";
import Reel from "../components/Reel.astro";
import cliReel from "../../../docs/demo-relay-cli.mp4?url";
import cliPosterSource from "../../../docs/poster-relay-cli.png";
import socialCard from "../../../docs/social-card.png";
import { cloneDir, install, plugin, repoUrl } from "../lib/repo";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// The try-it prompt from the README. The hero video is that same test app, the inbox and then the settings dialog, so
// the prompt above it asks for what it shows. The hero drops the fixture path to stay on one line, the try-it step
// keeps it because that is the one people copy.
const heroPrompt = "a launch video of the Relay inbox and the settings dialog";
const fixturePrompt = `${heroPrompt}, in evals/fixtures/relay-web`;
const title = plugin.displayName;
const description = plugin.description;
const cliPoster = await getImage({ src: cliPosterSource, format: "webp", width: 1920 });
// The same 1280x640 card the GitHub repository uses as its social preview, so a shared link looks the same everywhere.
const ogImage = await getImage({ src: socialCard, format: "png" });
const pageUrl = new URL(`${base}/`, Astro.site).href;

// Tells search engines, and the AI search built on them, what the page is about. It earns no rich result: Google wants
// a rating or a review for that, and there is none to give. "<" is escaped so no field can close the script tag.
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: plugin.displayName,
  alternateName: plugin.name,
  description,
  url: pageUrl,
  image: new URL(ogImage.src, Astro.site).href,
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "Claude Code plugin",
  softwareVersion: plugin.version,
  license: repoUrl("LICENSE"),
  sameAs: [plugin.repository],
  author: { "@type": "Person", name: plugin.author.name },
  keywords: plugin.keywords.join(", "),
  offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
}).replaceAll("<", "\\u003c");

// The reel in band 1. Settled and exit times come from its storyboard (demo/reel/storyboard.md), computed from the
// reel's code and asserted by the kit when the composition loads. A scene-score scan of docs/demo-relay-web.mp4 agrees
// on every exit to within 0.1s. "Needs" is plugin/skills/review/scripts/reading-time.mjs on those holds.
const holds = [
  { beat: "Title card", text: "Relay Focus mode", chars: 16, needs: 1.44, held: 1.71 },
  { beat: "Caption 01", text: "01 Inbox Every open issue, grouped by status.", chars: 45, needs: 3.15, held: 3.44 },
  {
    beat: "Settings dialog",
    text: "Focus mode Only show issues assigned to the web team.",
    chars: 53,
    needs: 3.62,
    held: 3.85,
  },
  {
    beat: "Caption 02",
    text: "02 Focus mode Shows only the issues assigned to your team.",
    chars: 58,
    needs: 3.91,
    held: 4.14,
  },
  { beat: "End card", text: "Relay Focus mode", chars: 16, needs: 1.44, held: 1.66 },
];

// Verbatim output of check-video.mjs and edge-scan.mjs on docs/demo-relay-web.mp4. Both exited 0.
const gateRun = [
  "$ node check-video.mjs reel.mp4",
  "ok    resolution 1920x1080",
  "ok    duration 15 to 30s (is 24.53s)",
  "ok    opens from black",
  "ok    ends on black",
  "ok    no near-empty stage mid-reel",
  "",
  "$ node edge-scan.mjs reel.mp4",
  "reel.mp4: 1920x1080, 24.53s, sampled every 0.2s, action safe is 67px left and right, 38px top and bottom",
  "  CROSSES  top     10.00s to  14.40s  content runs off the edge: crop it and check nothing is sliced",
  "  CROSSES  bottom  10.00s to  14.40s  content runs off the edge: crop it and check nothing is sliced",
];
const tone = (line: string) =>
  line.startsWith("$") ? "cmd" : line.startsWith("ok") ? "pass" : line.includes("CROSSES") ? "flag" : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" type="text/markdown" href={`${base}/index.md`} title="README as Markdown" />
    <link rel="describedby" type="text/plain" href={`${base}/llms.txt`} title="Index of the documentation for AI assistants" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <meta property="og:image:width" content={String(ogImage.attributes.width)} />
    <meta property="og:image:height" content={String(ogImage.attributes.height)} />
    <meta
      property="og:image:alt"
      content="React Launch Video, a Claude Code plugin: launch videos of your React app, rendered in Remotion from its real components, beside the Relay inbox"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={structuredData} />
  </head>
  <body>
    <div class="band-stage">
      <header class="wrap bar">
        <a class="wordmark" href={`${base}/`}>{title}</a>
        <a class="quiet-link" href={repoUrl()}>GitHub</a>
      </header>
    </div>

    <main>
      <section class="band-stage hero" aria-labelledby="hero-title">
        <div class="wrap hero-wrap">
          <h1 id="hero-title">A Claude Code plugin for React launch videos</h1>
          <div class="hero-reel">
            <Reel>
              <div class="session" slot="above" role="group" aria-label="The prompt in Claude Code that asks for this video">
                <span class="session-app">Claude Code</span>
                <p class="session-prompt">
                  <span class="session-caret" aria-hidden="true">&gt;</span>
                  <span><code>/{plugin.name}:create</code> {heroPrompt}</span>
                </p>
              </div>
            </Reel>
          </div>
          <div class="hero-install">
            <Command lines={install} label="Install in Claude Code" />
            <p class="note">Two commands in Claude Code. Needs Node.js 22.18 or later and ffmpeg.</p>
          </div>
        </div>
      </section>

      <section class="band" aria-labelledby="plan-title">
        <div class="wrap split">
          <div>
            <h2 id="plan-title" class="section-title">It plans before it renders</h2>
            <p class="lede">
              Claude storyboards every beat first. Text stays on screen long enough to read: a second per 17 characters,
              plus half a second.
            </p>
          </div>
          <figure class="holds">
            <table>
              <thead>
                <tr>
                  <th scope="col">On screen</th>
                  <th scope="col" class="num">Needs</th>
                  <th scope="col" class="num">Held</th>
                </tr>
              </thead>
              <tbody>
                {
                  holds.map((row) => (
                    <tr>
                      <th scope="row">
                        <span class="beat">{row.beat}</span>
                        <span class="text">
                          “{row.text}” <span class="chars">{row.chars} characters</span>
                        </span>
                      </th>
                      <td class="num">{row.needs.toFixed(2)}s</td>
                      <td class="num held">{row.held.toFixed(2)}s</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
            <figcaption class="caption">
              From the reel's storyboard, asserted when it loads and checked with <code>reading-time.mjs</code>.
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="band band-stage" aria-labelledby="ship-title">
        <div class="wrap">
          <h2 id="ship-title" class="section-title">It renders the product you ship</h2>
          <p class="lede">
            Your real React components, split so each frame can be drawn. It checks your tests and build still pass. CLIs are
            rebuilt from their own source.
          </p>
          <figure class="picture">
            <video
              class="cli-reel"
              controls
              muted
              playsinline
              loop
              preload="none"
              poster={cliPoster.src}
              width="1920"
              height="1080"
              aria-label="A video of the Relay CLI comparing local drafts with the server, choosing which to push and printing a summary"
            >
              <source src={cliReel} type="video/mp4" />
            </video>
            <figcaption class="caption">The Relay test CLI, rebuilt from its source.</figcaption>
          </figure>
        </div>
      </section>

      <section class="band" aria-labelledby="gates-title">
        <div class="wrap">
          <h2 id="gates-title" class="section-title">It is not done until the gates pass</h2>
          <p class="lede">
            Six scripted gates check every render, from the safe area to the fonts. A failing gate means another pass.
          </p>
          <figure class="picture">
            <pre class="terminal" tabindex="0" role="region" aria-label="Gate output"
              ><code>{gateRun.map((line) => <span class={tone(line)}>{`${line}\n`}</span>)}</code></pre>
            <figcaption class="caption">
              Two of the gates, run on the video at the top. Amber lines are flags for a person to check, not failures.
            </figcaption>
          </figure>

          <div class="review">
            <div>
              <h3>Already have a launch video?</h3>
              <p class="body">The review skill checks it against the same rules and ranks the fixes by severity.</p>
            </div>
            <Command
              lines={[`/${plugin.name}:review the video in ./reel and tell me what to fix`]}
              prose
              label="Ask for a review"
            />
          </div>
        </div>
      </section>

      <section class="band ask" aria-labelledby="ask-title">
        <div class="wrap ask-wrap">
          <h2 id="ask-title">
            <span>Try it on the test app first.</span>
            <span class="ask-then">Then point it at yours.</span>
          </h2>
          <p class="lede">
            A small React app ships in the repo. Nothing of yours is touched, and a finished video takes 20 to 30
            minutes.
          </p>
          <ol class="ask-steps">
            <li>
              <p>In a terminal</p>
              <Command lines={[`git clone ${plugin.repository} && cd ${cloneDir}`]} label="Clone the repo" />
            </li>
            <li>
              <p>In Claude Code, from that folder</p>
              <Command lines={install} label="Install the plugin" />
            </li>
            <li>
              <p>Then ask for a video</p>
              <Command
                lines={[`/${plugin.name}:create ${fixturePrompt}`]} prose
                label="Ask for a video of the test app"
              />
            </li>
          </ol>
        </div>
      </section>

      <section class="facts-band" aria-label="Scope, privacy and licensing">
       <div class="wrap facts">
        <div>
          <h3>What it covers</h3>
          <p>
            React apps and CLIs. Not Vue, Svelte, Angular, plain HTML, native apps or screen recordings.
          </p>
        </div>
        <div>
          <h3>What stays on your machine</h3>
          <p>
            Everything. Your product, video and data are never uploaded. It only downloads npm packages and Remotion's
            headless browser.
          </p>
        </div>
        <div>
          <h3>Licensing</h3>
          <p>
            {plugin.license} licensed. Remotion is free for individuals, non-profits and companies of up to 3 people.
            Bigger for-profits need a <a href="https://github.com/remotion-dev/remotion/blob/main/LICENSE.md"
              >Remotion Company License</a
            >. Independent, not affiliated with Remotion or React.
          </p>
        </div>
       </div>
      </section>
    </main>

    <footer class="footer-band">
      <div class="wrap footer">
        <span class="wordmark small">{title}</span>
        <span>v{plugin.version}</span>
        <a class="quiet-link" href={repoUrl("README.md")}>README</a>
        <a class="quiet-link" href={repoUrl("CHANGELOG.md")}>Changelog</a>
        <a class="quiet-link" href={`${base}/llms.txt`}>llms.txt</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
  }

  .wordmark {
    font-family: var(--display);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: var(--tracking-display);
    text-decoration: none;
  }

  .wordmark.small {
    font-size: var(--text-lg);
  }

  .quiet-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }

  /* ── 1. What it is: the video, as big as the first screen allows ── */

  .hero {
    padding-block: clamp(1rem, 3vw, 1.5rem) clamp(3rem, 7vw, 5rem);
  }

  .hero-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero h1 {
    margin-bottom: 1.25rem;
    font-size: clamp(2rem, 3.6vw, 2.75rem);
    font-weight: 800;
    line-height: 1.05;
  }

  /*
   * The prompt and the video it produced are the hero, and both stay above the fold: the video's width follows what is
   * left of the first screen after the bar, the headline and the prompt (about 17rem), as a 16:9 width. Never wider
   * than the column.
   */
  .hero-reel {
    width: min(100%, calc((100svh - 17rem) * 16 / 9));
    min-width: min(100%, 36rem);
    text-align: left;
  }

  /*
   * The Claude Code prompt, joined to the top of the video so the two read as one session: the ask, then what came
   * back. Reel squares off the video's top corners to meet it.
   */
  .session {
    display: grid;
    gap: 0.375rem;
    padding: 0.75rem 1rem 0.875rem;
    border: 1px solid var(--border-strong);
    border-bottom: 0;
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--panel);
    text-align: left;
  }

  .session-app {
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .session-prompt {
    display: flex;
    gap: 0.625rem;
    font-family: var(--mono);
    font-size: clamp(0.8rem, 1.2vw, 0.95rem);
    line-height: 1.5;
  }

  .session-caret {
    color: var(--muted);
  }

  .session-prompt code {
    color: var(--playhead);
    font-size: inherit;
  }

  .hero-install {
    width: 100%;
    max-width: 36rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    text-align: left;
  }

  .note {
    margin-top: 0.625rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  /* ── 2. It plans first ── */

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2.5rem clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .body {
    max-width: 52ch;
    margin-top: 1rem;
    color: var(--muted);
  }

  .holds {
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  th {
    text-align: left;
  }

  thead th {
    padding: 0 0 0.75rem;
    border-bottom: 1px solid var(--border-strong);
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  tbody th,
  tbody td {
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  tbody th {
    font-weight: 400;
  }

  .beat {
    display: block;
    font-weight: 600;
  }

  .text {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .chars {
    white-space: nowrap;
  }

  .num {
    width: 5.5rem;
    text-align: right;
  }

  td.num {
    color: var(--muted);
  }

  td.held {
    color: var(--clip-product);
    font-weight: 700;
  }

  .holds .caption {
    text-align: left;
  }

  .caption code {
    white-space: nowrap;
  }

  /* ── 3 and 4. A picture under its words ── */

  .picture {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
  }

  .cli-reel {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--stage);
  }

  .terminal {
    margin: 0;
    padding: clamp(1rem, 3vw, 1.75rem);
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--stage);
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.75;
  }

  .terminal .cmd {
    color: var(--text);
  }

  .terminal .pass {
    color: var(--clip-product);
  }

  .terminal .flag {
    color: var(--playhead);
  }

  .review {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2.5rem, 6vw, 5rem);
    align-items: center;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--border);
  }

  .review h3 {
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .review .body {
    margin-top: 0.5rem;
  }

  /* ── 5. The ask: the page's last word, so its loudest type ── */

  .ask {
    border-top: 1px solid var(--border);
  }

  .ask-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ask h2 {
    max-width: 22ch;
    margin-bottom: 1.5rem;
    font-size: clamp(2.25rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.05;
  }

  .ask h2 span {
    display: block;
  }

  .ask-then {
    color: var(--playhead);
  }

  .ask-steps {
    display: grid;
    gap: 1.25rem;
    width: 100%;
    max-width: 44rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  /* A grid item grows to its longest command unless it may shrink, and the command then scrolls inside it. */
  .ask-steps li {
    min-width: 0;
  }

  .ask-steps p {
    margin-bottom: 0.5rem;
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  /* ── Facts and footer ── */

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem clamp(2rem, 5vw, 3.5rem);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .facts-band,
  .footer-band {
    border-top: 1px solid var(--border);
  }

  .facts h3 {
    margin-bottom: 0.5rem;
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: 0;
  }

  .facts p {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.5rem;
    padding-block: 1.5rem 2.5rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .footer .wordmark {
    color: var(--text);
  }

  @media (max-width: 900px) {
    .split,
    .review,
    .facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
