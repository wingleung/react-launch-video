---
interface Props {
  lines: string[];
  label: string;
  /** A prompt reads as a sentence, so it wraps. A shell command scrolls rather than break inside a word. */
  prose?: boolean;
}

const { lines, label, prose = false } = Astro.props;
// A command that scrolls has to take focus, or outside Chromium a keyboard cannot scroll it.
const scrollable = prose ? {} : { role: "group", "aria-label": "Command", tabindex: 0 };
---

<div class:list={["command", { prose }]} role="group" aria-label={label}>
  <pre {...scrollable}><code>{lines.join("\n")}</code></pre>
  <button type="button" data-copy={lines.join("\n")} aria-label={`Copy: ${label}`}>Copy</button>
  <span class="sr-only" role="status" data-copy-status></span>
</div>

<style>
  .command {
    position: relative;
    min-width: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--panel);
  }

  pre {
    margin: 0;
    padding: 14px 84px 14px 16px;
    overflow-x: auto;
    line-height: 1.7;
  }

  .prose pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  button {
    position: absolute;
    top: 9px;
    right: 9px;
    padding: 4px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    background: var(--stage);
    color: var(--text);
    font: 500 0.78rem var(--mono);
    cursor: pointer;
  }

  button:hover {
    border-color: var(--text);
  }
</style>

<script>
  for (const command of document.querySelectorAll<HTMLElement>(".command")) {
    const button = command.querySelector<HTMLButtonElement>("button[data-copy]")!;
    const status = command.querySelector<HTMLElement>("[data-copy-status]")!;
    let reset: ReturnType<typeof setTimeout> | undefined;

    button.addEventListener("click", async () => {
      clearTimeout(reset);
      // Emptied first, so a second click that lands on the same words is still announced.
      status.textContent = "";
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.textContent = status.textContent = "Copied";
      } catch {
        getSelection()?.selectAllChildren(command.querySelector("pre")!);
        button.textContent = "Selected";
        status.textContent = "Could not copy. The command is selected, copy it from the keyboard.";
      }
      reset = setTimeout(() => {
        button.textContent = "Copy";
        status.textContent = "";
      }, 1600);
    });
  }
</script>
